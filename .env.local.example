# =============================================================================
# Settoku OS - environment template
# Copy to .env.local and fill in. Only the Supabase block is required to boot;
# every integration key is optional, and each feature degrades gracefully when
# its key is absent. NEVER commit your real .env.local (it is git-ignored).
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app (used in links / redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Campaign tracking / UTM link bank (optional) ---
# Your main funnel URL that the /go/* short links redirect to (with UTMs attached).
# e.g. https://yourbrand.com/start  (see UTM-GUIDE.md)
NEXT_PUBLIC_FUNNEL_URL=

# --- Security ---
# 32-byte key (hex or base64) used to encrypt per-tenant secrets at rest.
SECRETS_ENCRYPTION_KEY=
# Shared secret required to call /api/cron/* endpoints.
CRON_SECRET=
# Comma-separated allowlist of emails permitted to sign in.
TEAM_ALLOWED_EMAILS=

# --- AI assistant (Settoku Chat) ---
# Provider: "groq" (free tier) or "anthropic". Defaults to groq if GROQ_API_KEY is set.
AI_CHAT_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
# Optional guardrails (sane defaults applied if unset)
# AI_CHAT_ENABLED=true
# AI_DAILY_MESSAGE_CAP=250
# AI_DAILY_TOKEN_CAP=500000

# --- Research (Content page, the Research tab) ---
# Every key here is free. Any one that is missing just turns off the part that needs it, and the
# page says which key it was and where to get one. Never put a paid key in this block.
#
# Reads the recent posts of the Instagram accounts you track. The only thing in Research that can
# cost money, and every read carries a hard spend cap. Free sign-up, then Settings and Integrations.
# https://console.apify.com
APIFY_API_TOKEN=
# Optional: more free Apify accounts, tried in order when one has spent its monthly credit.
# APIFY_API_TOKEN_2=
# APIFY_API_TOKEN_3=

# Writes the hooks and the scripts, scores your drafts, and turns a reel's audio into words when the
# video itself cannot be watched. Free. https://console.groq.com/keys
# (This is the same key the Settoku Chat block above uses. Set it once.)
# GROQ_API_KEY=

# Watches the video itself, so a breakdown is about what is on screen and not a guess from the
# caption. Free. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: more free Gemini projects, comma separated, so one project's daily allowance running out
# does not stop the day.
# GEMINI_API_KEYS=

# Reads YouTube channels and their uploads, and finds creators by niche. Free. Enable the YouTube
# Data API v3 at https://console.cloud.google.com then Credentials, Create API key.
YOUTUBE_API_KEY=

# Optional. A free model on OpenRouter, used only after Groq and Gemini. The model id MUST end in
# ":free" or it is ignored, because an OpenRouter account can hold real credit.
# OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=google/gemma-3-27b-it:free

# Optional. The address this dashboard is deployed at, such as https://your-app.vercel.app.
# When it is set, Apify calls your dashboard the moment a scan finishes and the results appear on
# their own. When it is not, the Research page collects the results itself while it is open.
RESEARCH_PUBLIC_URL=

# --- Google Sheets data source (optional) ---
# Enables the sheet-backed metrics for ONE workspace. Leave unset to disable.
GOOGLE_SERVICE_ACCOUNT_JSON=
SALES_SHEET_ID=
SALES_SHEET_AGENCY_ID=

# --- Payment / revenue integrations (optional) ---
FANBASIS_API_KEY=
FANBASIS_API_URL=
FANBASIS_TARGET_AGENCY_ID=
FANBASIS_WEBHOOK_SECRET=

# --- Email / CRM (optional) ---
KIT_API_KEY=
KIT_API_SECRET=
TYPEFORM_API_KEY=
TYPEFORM_WEBHOOK_SECRET=

# --- Calls / scheduling (optional) ---
ICLOSED_API_KEY=
ICLOSED_WEBHOOK_SECRET=
RETELL_API_KEY=
RETELL_FROM_NUMBER=

# --- Webinars (optional) ---
WEBINARJAM_API_KEY=
WEBINARJAM_TARGET_AGENCY_ID=

# --- SMS (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Slack notifications (optional) ---
SLACK_BOT_TOKEN=
SLACK_OPS_CHANNEL=
SLACK_DAILY_DIGEST_CHANNEL=
SLACK_WEEKLY_REPORT_CHANNEL=
SLACK_WINS_CHANNEL=
SLACK_CREATOR_DIGEST_CHANNEL=

# --- Misc integrations (optional) ---
DM_CLICK_AGENCY_ID=
CREATOR_DIGEST_AGENCY_ID=
REVENUE_GOAL=
MAKE_API_KEY=
N8N_API_KEY=
N8N_BASE_URL=
BOOSEND_API_KEY=
CLOSE_API_KEY=
PAGESPEED_API_KEY=
HARNESS_BASE_URL=

# Branding
NEXT_PUBLIC_SETTOKU_RELEASE=0.1.0

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder-only template SHOULD be tracked so onboarding/docs persist
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local env (added by settoku-os setup)
.env.local
.env*.local

# Sandbox profile
sandbox_profile/

# CSV exports (contain client/lead PII — generated locally, not for repo)
/exports/

# Local intermediates (scratch SQL, dossiers, temp artifacts — regenerated, never committed)
/.tmp/

# supabase CLI local state (links to YOUR project; never commit)
supabase/.temp/
supabase/.branches/

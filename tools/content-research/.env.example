# Copy this file to ".env" in the same folder and paste your own keys in.
# Your .env is never committed. Nothing in this tool will ever touch a paid key.
#
# Keeping all your keys in one file at the top of the repo instead? Point this tool at it:
#   RESEARCH_ENV_FILE=/full/path/to/your/.env
#
# Real tokens look like apify_api_..., gsk_... and AIza..., so if what you pasted does not
# start like that, you have copied the wrong thing.

# ---------------------------------------------------------------- required

# Reads the recent posts of the Instagram accounts you track. The ONLY thing here that can cost
# money, and it comes out of Apify's free monthly credit first.
# Free account: https://console.apify.com/sign-up
# Then copy the token from https://console.apify.com/settings/integrations
APIFY_API_TOKEN=paste-your-apify-token-here

# Writes the hooks and the scripts, and turns a reel's audio into text when the video cannot be
# watched. Free, and generous: about 1,000 requests a day.
# Get one: https://console.groq.com/keys
GROQ_API_KEY=paste-your-groq-key-here

# Watches the video itself, so a breakdown is about what is actually on screen and not a guess from
# the caption. Free, about 20 video requests a day per key.
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here

# Reads YouTube channels and their uploads, and finds creators by niche. Free.
# Turn the YouTube Data API v3 on at
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
# then make an API key under Credentials.
YOUTUBE_API_KEY=paste-your-youtube-key-here

# ---------------------------------------------------------------- optional but worth it

# Never run out: every free Apify account comes with its own monthly credit. Make two or three free
# accounts and number the tokens. The tool rolls to the next one the moment one runs dry.
# APIFY_API_TOKEN_2=paste-your-second-apify-token-here
# APIFY_API_TOKEN_3=paste-your-third-apify-token-here

# Same idea for the free AI keys. Each Google project gets its own daily video allowance, and each
# Groq account its own. Separate them with commas.
# GEMINI_API_KEYS=first-key,second-key
# GROQ_API_KEYS=first-key,second-key

# ---------------------------------------------------------------- your dashboard (for sync)

# Only needed for "npx tsx research.ts sync". This is YOUR Supabase project, the one you deployed
# this dashboard against. Supabase, your project, Settings, then Data API for the URL and
# API keys for the service_role key.
#
# The service_role key can read and write everything in your database. Keep it in this file, and
# never paste it into a chat, a repo, a screenshot or a browser.
# DASHBOARD_SUPABASE_URL=https://yourprojectref.supabase.co
# DASHBOARD_SUPABASE_SERVICE_KEY=paste-your-service-role-key-here

# ---------------------------------------------------------------- never set these

# This tool refuses to use a paid key. ANTHROPIC_API_KEY and OPENAI_API_KEY are ignored on purpose.
# If a command says it is out of free allowance, wait for the reset or add another free key above.

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/self-discover",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/webinar-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 17 * * 1-5"
    }
  ]
}
